<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     width="440"
     height="28"
     viewBox="0 0 440 28"
     fill="none"
     role="img"
     aria-label="{{ repo_name }} sponsorship shield">
  <style>
    .base { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    .shield-tag { font-size: 10px; font-weight: 700; fill: #f0883e; letter-spacing: 0.5px; }
    .shield-body { font-size: 11px; font-weight: 600; fill: #ffffff; }
    .shield-headline { font-size: 10px; font-weight: 500; fill: #8b949e; }
    .shield-cta { font-size: 10px; font-weight: 700; fill: #2ea043; letter-spacing: 0.2px; }
    a { cursor: pointer; text-decoration: none; }
    a:hover .shield-bg-right { fill: #1c2128; }
    a:hover .shield-cta { fill: #3fb950; text-decoration: underline; }

    /* Animated pulse indicator for live sponsor */
    @keyframes pulse-dot {
      0% { r: 3; opacity: 1; }
      50% { r: 4.5; opacity: 0.4; }
      100% { r: 3; opacity: 1; }
    }
    .pulse-glow { animation: pulse-dot 2.5s ease-in-out infinite; }

    @media (prefers-color-scheme: light) {
      .shield-bg-left { fill: #f6f8fa; stroke: #d0d7de; }
      .shield-bg-right { fill: #ffffff; }
      .shield-border { stroke: #d0d7de; }
      .shield-body { fill: #24292f; }
      .shield-headline { fill: #57606a; }
      a:hover .shield-bg-right { fill: #f3f4f6; }
    }
  </style>

  <!-- Left Side: ReadmePay / Sponsor Brand Pill -->
  <g class="base">
    <a href="{{ click_url }}" xlink:href="{{ click_url }}" target="_blank" rel="noopener noreferrer">
      <!-- Shield Outer Boundary with Rounded Corners -->
      <clipPath id="shieldClip">
        <rect x="0" y="0" width="440" height="28" rx="6"/>
      </clipPath>

      <g clip-path="url(#shieldClip)">
        <!-- Left Banner: ReadmePay / Sponsor Tag -->
        <rect class="shield-bg-left" x="0" y="0" width="88" height="28" fill="#161b22"/>
        <!-- Animated pulsing green live dot -->
        <circle class="pulse-glow" cx="12" cy="14" r="3" fill="#2ea043"/>
        <text x="50" y="18" text-anchor="middle" class="shield-tag">SPONSOR</text>

        <!-- Right Banner: Sponsor Name + Headline + CTA -->
        <rect class="shield-bg-right" x="88" y="0" width="352" height="28" fill="#0d1117"/>
        {% if has_ad %}
        <text x="100" y="18">
          <tspan class="shield-body">{{ sponsor_name | truncate_text(16) }}</tspan>
          <tspan class="shield-headline" dx="6">{{ headline | truncate_text(26) }}</tspan>
        </text>
        <text x="428" y="18" text-anchor="end" class="shield-cta">{{ cta_text | truncate_text(12) }} &#x2192;</text>
        {% else %}
        <text x="100" y="18">
          <tspan class="shield-body">Sponsor {{ repo_name | truncate_text(16) }}</tspan>
          <tspan class="shield-headline" dx="6">Reach active software developers</tspan>
        </text>
        <text x="428" y="18" text-anchor="end" class="shield-cta">&#x2665; Join &#x2192;</text>
        {% endif %}
      </g>

      <!-- Border Stroke -->
      <rect class="shield-border" x="0.5" y="0.5" width="439" height="27" rx="5.5" fill="none" stroke="#30363d" stroke-width="1"/>
    </a>
  </g>
</svg>
