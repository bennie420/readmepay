<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     width="500"
     height="110"
     viewBox="0 0 500 110"
     fill="none"
     role="img"
     aria-label="{{ repo_name }} sponsorship badge">
  <style>
    .base { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    .repo-title { font-size: 14.5px; font-weight: 700; fill: {{ palette.text_title | default('#58a6ff') }}; letter-spacing: -0.2px; }
    .meta-text { font-size: 11.5px; font-weight: 600; fill: {{ palette.text_meta | default('#e6edf3') }}; }
    .lang-text { font-size: 11px; font-weight: 500; fill: #c9d1d9; }
    .ci-text { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .ad-card { cursor: pointer; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
    .ad-card:hover { stroke: {{ palette.border | default('#58a6ff') }}; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.4)); }
    .ad-tag { font-size: 8.5px; font-weight: 800; fill: #58a6ff; letter-spacing: 0.6px; }
    .sponsor-name { font-size: 12px; font-weight: 700; fill: #ffffff; }
    .ad-headline { font-size: 10.5px; font-weight: 500; fill: {{ palette.text_headline | default('#c9d1d9') }}; line-height: 1.35; }
    .cta-text { font-size: 10px; font-weight: 700; fill: #ffffff; letter-spacing: 0.2px; }
    .cta-button { cursor: pointer; transition: transform 0.2s; }
    .cta-button:hover rect { fill: {{ palette.btn_bg_1 | default('#2ea043') }}; filter: drop-shadow(0 0 6px rgba(46, 160, 67, 0.6)); }
    a { cursor: pointer; text-decoration: none; }
    
    /* Animated pulsing beacon dot on live sponsor */
    @keyframes pulse-dot {
      0% { r: 3px; opacity: 1; }
      50% { r: 4.5px; opacity: 0.45; }
      100% { r: 3px; opacity: 1; }
    }
    .live-beacon { animation: pulse-dot 2.2s ease-in-out infinite; }

    /* Animated gradient border shimmer */
    @keyframes shimmer {
      0% { stroke-dashoffset: 0; }
      100% { stroke-dashoffset: 200; }
    }
    .ad-inner-card:hover { stroke-dasharray: 6 3; animation: shimmer 4s linear infinite; }

    {% if marquee %}
    /* Smooth Continuous Sponsor Marquee */
    @keyframes banner-marquee-scroll {
      0% { transform: translateX(110px); }
      100% { transform: translateX(-190px); }
    }
    .banner-marquee-track {
      animation: banner-marquee-scroll 10s linear infinite;
    }
    .banner-marquee-track:hover {
      animation-play-state: paused;
    }
    {% endif %}

    @media (prefers-color-scheme: light) {
      .outer-card { fill: #ffffff !important; stroke: #d0d7de !important; }
      .repo-title { fill: #0969da !important; }
      .meta-text { fill: #24292f !important; }
      .lang-text { fill: #57606a !important; }
      .ad-inner-card { fill: #f6f8fa !important; stroke: #d0d7de !important; }
      .ad-headline { fill: #24292f !important; }
      .sponsor-name { fill: #1f2328 !important; }
      .divider-line { stroke: #d0d7de !important; }
    }
  </style>

  <!-- Outer Card Container with Smooth Corners -->
  <rect class="outer-card" x="0.5" y="0.5" width="499" height="109" rx="10" fill="url(#cardBg)" stroke="{{ palette.border | default('#30363d') }}" stroke-width="1"/>
  <!-- Top Rim Light Accent -->
  <line x1="12" y1="1" x2="488" y2="1" stroke="url(#rimLight)" stroke-width="1.2" stroke-linecap="round"/>

  {% set is_sponsor_left = (sponsor_position == 'left') %}
  {% set ad_card_x = 8 if is_sponsor_left else 256 %}
  {% set meta_x = 256 if is_sponsor_left else 16 %}
  {% set div_x = 248 if is_sponsor_left else 248 %}

  <!-- Sponsor Ad Card Component -->
  <g class="base" id="sponsor-card">
    {% if has_ad %}
    <a href="{{ click_url }}" xlink:href="{{ click_url }}" target="_blank" rel="noopener noreferrer">
      <!-- Inset Glassmorphic Card -->
      <rect class="ad-card ad-inner-card" x="{{ ad_card_x }}" y="8" width="236" height="94" rx="8" fill="url(#adBg)" stroke="{{ palette.border | default('#30363d') }}" stroke-width="1"/>

      <!-- Header: Pulsing Live Beacon Pill + Sponsor Name -->
      <g transform="translate({{ ad_card_x + 12 }}, 16)">
        <rect x="0" y="0" width="68" height="17" rx="8.5" fill="#1b2433" stroke="#388bfd" stroke-opacity="0.5" stroke-width="0.8"/>
        <circle class="live-beacon" cx="9" cy="8.5" r="3" fill="#3fb950"/>
        <text x="39" y="11.5" text-anchor="middle" class="ad-tag">SPONSOR</text>
        <text x="76" y="12" class="sponsor-name">{{ sponsor_name | truncate_text(20) }}</text>
      </g>

      <!-- Headline (multi-line supported via tspan, with marquee option) -->
      <g clip-path="url(#headlineClip-{{ ad_card_x }})">
        {% if marquee %}
        <g class="banner-marquee-track">
          <text x="{{ ad_card_x + 12 }}" y="47" class="ad-headline">
            <tspan>{{ headline }}</tspan>
          </text>
        </g>
        {% else %}
        <text x="{{ ad_card_x + 12 }}" y="47" class="ad-headline">
          <tspan x="{{ ad_card_x + 12 }}" dy="0">{{ headline | truncate_text(35) }}</tspan>
          {% if headline | length > 35 %}
          <tspan x="{{ ad_card_x + 12 }}" dy="13.5">{{ headline[35:] | truncate_text(35) }}</tspan>
          {% endif %}
        </text>
        {% endif %}
      </g>

      <!-- Modern Gradient Pill CTA Button -->
      <g class="cta-button" transform="translate({{ ad_card_x + 12 }}, 73)">
        <rect x="0" y="0" width="128" height="22" rx="11" fill="url(#btnBg)"/>
        <text x="64" y="14.5" text-anchor="middle" class="cta-text">{{ cta_text | truncate_text(16) }} &#x2192;</text>
      </g>
    </a>
    {% else %}
    <a href="{{ click_url | default('/sponsor') }}" xlink:href="{{ click_url | default('/sponsor') }}" target="_blank" rel="noopener noreferrer">
      <!-- Fallback / Community Onboarding Card -->
      <rect class="ad-card ad-inner-card" x="{{ ad_card_x }}" y="8" width="236" height="94" rx="8" fill="#131922" stroke="{{ palette.border | default('#30363d') }}" stroke-width="1" stroke-dasharray="3,3"/>
      <g transform="translate({{ ad_card_x + 12 }}, 16)">
        <rect x="0" y="0" width="70" height="17" rx="8.5" fill="#1a2230" stroke="#58a6ff" stroke-width="0.7"/>
        <circle cx="9" cy="8.5" r="3" fill="#58a6ff"/>
        <text x="40" y="11.5" text-anchor="middle" class="ad-tag" fill="#58a6ff">AVAILABLE</text>
        <text x="78" y="12" class="sponsor-name">ReadmePay</text>
      </g>
      <text x="{{ ad_card_x + 12 }}" y="48" class="ad-headline">Sponsor this open-source project</text>
      <g class="cta-button" transform="translate({{ ad_card_x + 12 }}, 73)">
        <rect x="0" y="0" width="128" height="22" rx="11" fill="#1f2937" stroke="#374151" stroke-width="1"/>
        <text x="64" y="14.5" text-anchor="middle" class="cta-text" fill="#58a6ff">&#x2665; Sponsor Repo &#x2192;</text>
      </g>
    </a>
    {% endif %}
  </g>

  <!-- Repository Metadata Component -->
  <g class="base" id="repo-metadata">
    <!-- GitHub Book Octicon + Repo Name -->
    <g transform="translate({{ meta_x }}, 19)">
      <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 0 0 1.5h2.5a2.25 2.25 0 0 0 2.25-2.25V.75A2.25 2.25 0 0 0 13.25-1.5H4.5A4 4 0 0 0 .5 2.5v11A2.5 2.5 0 0 0 3 16h10.25a.75.75 0 0 0 0-1.5H3a1 1 0 0 1-1-1v-11z" fill="{{ palette.text_title | default('#58a6ff') }}" transform="scale(0.8) translate(0, 2)"/>
      <g clip-path="url(#repoClip-{{ meta_x }})">
        <text x="18" y="11" class="repo-title">{{ repo_name }}</text>
      </g>
    </g>

    <!-- Star Count Pill + Language Pill -->
    <g transform="translate({{ meta_x }}, 45)">
      <!-- Star Count Badge -->
      {% if not hide_stars %}
      <g id="star-pill" transform="translate(0, 0)">
        <rect x="0" y="0" width="70" height="20" rx="5" fill="#161e2b" stroke="{{ palette.border | default('#30363d') }}" stroke-width="0.8"/>
        <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" fill="#e3b341" transform="scale(0.7) translate(7, 3)"/>
        <text x="24" y="14" class="meta-text">{{ formatted_stars }}</text>
      </g>
      {% endif %}

      <!-- Language Pill -->
      {% if language %}
      <g id="lang-pill" transform="translate({% if hide_stars %}0{% else %}76{% endif %}, 0)">
        <rect x="0" y="0" width="74" height="20" rx="5" fill="#161e2b" stroke="{{ palette.border | default('#30363d') }}" stroke-width="0.8"/>
        <circle cx="10" cy="10" r="4" fill="{{ lang_color }}"/>
        <text x="19" y="14" class="lang-text">{{ language | truncate_text(9, '') }}</text>
      </g>
      {% endif %}
    </g>

    <!-- CI/CD Status & Trust Signal -->
    <g transform="translate({{ meta_x }}, 76)">
      {% if ci_status %}
      <g id="ci-pill">
        <rect x="0" y="0" width="68" height="18" rx="9" fill="{{ ci_bg_color }}"/>
        <text x="34" y="12" text-anchor="middle" fill="{{ ci_text_color }}" class="ci-text">{{ ci_status }}</text>
      </g>
      {% endif %}
      <text x="{% if ci_status %}74{% else %}0{% endif %}" y="12.5" font-size="9" font-weight="600" fill="#6e7681">&#8226; ReadmePay Verified</text>
    </g>
  </g>

  <!-- Elegant Vertical Divider -->
  <line class="divider-line" x1="{{ div_x }}" y1="12" x2="{{ div_x }}" y2="98" stroke="{{ palette.border | default('#30363d') }}" stroke-width="1" stroke-dasharray="2,2" opacity="0.6"/>

  <defs>
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="{{ palette.card_bg_0 | default('#111620') }}"/>
      <stop offset="100%" stop-color="{{ palette.card_bg_1 | default('#0b0e14') }}"/>
    </linearGradient>
    <linearGradient id="rimLight" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="{{ palette.text_title | default('#58a6ff') }}" stop-opacity="0.6"/>
      <stop offset="50%" stop-color="{{ palette.btn_bg_1 | default('#2ea043') }}" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="{{ palette.text_title | default('#58a6ff') }}" stop-opacity="0.3"/>
    </linearGradient>
    <linearGradient id="adBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="{{ palette.ad_bg_0 | default('#161e2b') }}"/>
      <stop offset="100%" stop-color="{{ palette.ad_bg_1 | default('#0e141e') }}"/>
    </linearGradient>
    <linearGradient id="btnBg" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="{{ palette.btn_bg_0 | default('#238636') }}"/>
      <stop offset="100%" stop-color="{{ palette.btn_bg_1 | default('#2ea043') }}"/>
    </linearGradient>
    <clipPath id="repoClip-{{ meta_x }}">
      <rect x="18" y="0" width="200" height="20"/>
    </clipPath>
    <clipPath id="headlineClip-{{ ad_card_x }}">
      <rect x="{{ ad_card_x + 12 }}" y="37" width="220" height="28"/>
    </clipPath>
  </defs>
</svg>
