<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     width="300"
     height="28"
     viewBox="0 0 300 28"
     fill="none"
     role="img"
     aria-label="{{ repo_name }} sponsorship goal badge">
  <style>
    .f-sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    .goal-tag { font-size: 10px; font-weight: 800; fill: {{ palette.accent | default('#38bdf8') }}; letter-spacing: 0.5px; }
    .goal-text { font-size: 10px; font-weight: 700; fill: #ffffff; }
    .goal-sub { font-size: 9px; font-weight: 600; fill: {{ palette.text_meta | default('#94a3b8') }}; }
    a { cursor: pointer; text-decoration: none; }
    
    @keyframes progress-shimmer {
      0% { opacity: 0.7; }
      50% { opacity: 1; }
      100% { opacity: 0.7; }
    }
    .bar-fill { animation: progress-shimmer 2.5s ease-in-out infinite; }

    @media (prefers-color-scheme: light) {
      .goal-left-bg { fill: #f6f8fa !important; }
      .goal-right-bg { fill: #ffffff !important; }
      .goal-border { stroke: #d0d7de !important; }
      .goal-text { fill: #1f2328 !important; }
    }
  </style>

  <a href="{{ click_url }}" xlink:href="{{ click_url }}" target="_blank" rel="noopener noreferrer">
    <clipPath id="goalClip">
      <rect x="0" y="0" width="300" height="28" rx="6"/>
    </clipPath>

    <g clip-path="url(#goalClip)" class="f-sans">
      <!-- Left Tag: Goal Category -->
      <rect class="goal-left-bg" x="0" y="0" width="115" height="28" fill="{{ palette.card_bg_0 | default('#161b22') }}"/>
      <text x="57" y="18" text-anchor="middle" class="goal-tag">&#x25C6; MONTHLY GOAL</text>

      <!-- Right Progress Section -->
      <rect class="goal-right-bg" x="115" y="0" width="185" height="28" fill="{{ palette.card_bg_1 | default('#0d1117') }}"/>

      <!-- Progress Track & Bar -->
      <g transform="translate(125, 7)">
        <text x="0" y="9" class="goal-text">{% if has_ad %}80% Funded{% else %}Open for Sponsors{% endif %}</text>
        <text x="100" y="9" class="goal-sub">{% if has_ad %}Active{% else %}Fund Repo{% endif %} &#x2192;</text>
        
        <!-- Progress Bar Background -->
        <rect x="0" y="14" width="150" height="4" rx="2" fill="{{ palette.border | default('#30363d') }}"/>
        <!-- Progress Bar Fill -->
        <rect class="bar-fill" x="0" y="14" width="{% if has_ad %}120{% else %}25{% endif %}" height="4" rx="2" fill="{{ palette.btn_bg_1 | default('#2ea043') }}"/>
      </g>

      <!-- Border outline -->
      <rect class="goal-border" x="0.5" y="0.5" width="299" height="27" rx="5.5" fill="none" stroke="{{ palette.border | default('#30363d') }}" stroke-width="1"/>
    </g>
  </a>
</svg>
